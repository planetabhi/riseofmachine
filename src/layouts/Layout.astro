---
import { ClientRouter } from "astro:transitions";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import Sidebar from "../components/Sidebar.astro";
import ActionBar from "../components/ActionBar.astro";
import ContentTopbar from "../components/ContentTopbar.astro";
import Hero from "../components/Hero.astro";
import DetailPanel from "../components/DetailPanel.astro";
import BookmarkSync from "../components/BookmarkSync.astro";
import MoireBackground from "../components/MoireBackground.astro";
import '@new-ui/foundations/css';
import '@new-ui/themes/css';
import "../styles/transitions.css";

export interface Props {
    site: string;
    title: string;
    tagline: string;
    pageTitle?: string;
    pageDescription?: string;
    canonicalUrl?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogUrl?: string;
    ogType?: string;
    ogSiteName?: string;
    twitterCard?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    twitterImage?: string;
    pageFavicon?: string;
    showSearch?: boolean;
    showLatestFilter?: boolean;
    showParticles?: boolean;
    showHero?: boolean;
    searchPlaceholder?: string;
    // Sidebar vertical config (forwarded to <Sidebar>); undefined = tools defaults.
    sidebarCategoryIndex?: Record<string, { title: string; count: number }>;
    sidebarBasePath?: string;
    sidebarHomeHref?: string;
    sidebarHomeLabel?: string;
    sidebarShowFavorites?: boolean;
    sidebarPersistKey?: string;
    sidebarTotalCount?: number;
}

const {
    site,
    title,
    tagline,
    pageTitle,
    pageDescription,
    canonicalUrl,
    ogTitle,
    ogDescription,
    ogImage,
    ogUrl,
    ogType,
    ogSiteName,
    twitterCard,
    twitterTitle,
    twitterDescription,
    twitterImage,
    pageFavicon,
    showSearch = false,
    showLatestFilter = true,
    showHero = false,
    searchPlaceholder = "Search by name, category, or feature...",
    sidebarCategoryIndex,
    sidebarBasePath,
    sidebarHomeHref,
    sidebarHomeLabel,
    sidebarShowFavorites,
    sidebarPersistKey,
    sidebarTotalCount,
} = Astro.props;

// Site-wide social card fallback; pages may override via ogImage/twitterImage.
const DEFAULT_SOCIAL_IMAGE = "https://riseofmachine.com/og-cover.png";
const resolvedOgImage = ogImage ?? DEFAULT_SOCIAL_IMAGE;
const resolvedTwitterImage = twitterImage ?? ogImage ?? DEFAULT_SOCIAL_IMAGE;
const resolvedTwitterCard = twitterCard ?? "summary_large_image";
---

<!doctype html>
<html lang="en" data-new-ui-theme="flexoki-dark">
    <head>
        <script is:inline>
            (function(){try{var T=['sargam-dark','aura','ayu-dark','catppuccin-mocha','dracula','flexoki-dark','monokai','night-owl','synthwave-84','tokyo-night'];var t=localStorage.getItem('rom_theme');if(T.indexOf(t)>-1)document.documentElement.setAttribute('data-new-ui-theme',t);}catch(e){}})();
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={pageFavicon || "/rise-of-machine.svg"}
        />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content="#000000" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Rise of Machine — Latest AI Tools"
            href="/rss.xml"
        />
        <meta name="generator" content={Astro.generator} />
        <title>
            {
                pageTitle
                    ? `${pageTitle} | Rise of Machine`
                    : `${site} — AI tools curated by autonomous AI agents for makers and SMBs.`
            }
        </title>
        <meta name="author" content="@planetabhi" />
        <meta
            name="description"
            content={pageDescription ||
                "AI tools curated by autonomous AI agents for makers and SMBs."}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        {ogTitle && <meta property="og:title" content={ogTitle} />}
        {ogType && <meta property="og:type" content={ogType} />}
        {
            ogDescription && (
                <meta property="og:description" content={ogDescription} />
            )
        }
        <meta property="og:image" content={resolvedOgImage} />
        {!ogImage && <meta property="og:image:width" content="1200" />}
        {!ogImage && <meta property="og:image:height" content="630" />}
        {ogUrl && <meta property="og:url" content={ogUrl} />}
        {ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
        <meta name="twitter:card" content={resolvedTwitterCard} />
        {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
        {
            twitterDescription && (
                <meta name="twitter:description" content={twitterDescription} />
            )
        }
        <meta name="twitter:image" content={resolvedTwitterImage} />
        <!-- Google tag (gtag.js) -->
        <script
            type="text/partytown"
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-S08Z38BTMJ"
        ></script>
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                window.dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-S08Z38BTMJ");
        </script>
        <ClientRouter />
        <WebSiteSchema />
    </head>

    <body>
        <a href="#main-content" class="skip-link">Skip to main content</a>
        <MoireBackground />
        <Sidebar
            showLatestFilter={showLatestFilter}
            categoryIndex={sidebarCategoryIndex}
            basePath={sidebarBasePath}
            homeHref={sidebarHomeHref}
            homeLabel={sidebarHomeLabel}
            showFavorites={sidebarShowFavorites}
            persistKey={sidebarPersistKey}
            totalCount={sidebarTotalCount}
        />
        <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>
        <div class="app-shell">
            <div class="app-content">
                <ContentTopbar
                    title={title}
                    showSearch={showSearch}
                    searchPlaceholder={searchPlaceholder}
                    minimal={showHero}
                />
                {showHero && (
                    <Hero
                        title={title}
                        tagline={tagline}
                        showSearch={showSearch}
                        searchPlaceholder={searchPlaceholder}
                    />
                )}
                <slot />
            </div>
            <ActionBar basePath={sidebarBasePath} />
        </div>
        <DetailPanel />
        <slot name="side-panel" />
        <BookmarkSync />
        <script is:inline>
            (function () {
                try {
                    var raw = localStorage.getItem("rom_bookmarks:v1") || localStorage.getItem("rom_bookmarks");
                    var count = 0;
                    if (raw) {
                        try {
                            count = JSON.parse(raw).length || 0;
                        } catch (e) {}
                    }
                    var countEl = document.getElementById("favoritesCount");
                    if (countEl) countEl.textContent = count > 0 ? String(count) : "";
                } catch (e) {}
            })();
        </script>
    </body>
</html>
<style is:global>
    @font-face {
        font-family: "ROM-Regular";
        src: url("/woffs/ROM-Regular.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Bold";
        src: url("/woffs/ROM-Bold.woff2") format("woff2");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "ROM-Mono";
        src: url("/woffs/ROM-Mono.woff2") format("woff2");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    :root {
        --accent: var(--link);
         --background-high-contrast: oklch(0% 0 0);
        --body-copy: "ROM-Regular", var(--system-ui);
        --monospace: "ROM-Mono", var(--monospace-code);
        --body-strong: "ROM-Bold", var(--system-ui);
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    html {
        font-family: var(--body-copy);
        background-color: var(--background-high-contrast);
    }
 
    * {
        scrollbar-width: thin;
        scrollbar-color: var(--border-muted) transparent;
    }
    *::-webkit-scrollbar {
        width: 2px;
        height: 2px;
    }
    *::-webkit-scrollbar-track {
        background: transparent;
    }
    *::-webkit-scrollbar-thumb {
        background-color: var(--border-muted);
        border-radius: var(--spacing-01);
    }
    body {
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        align-items: stretch;
        overflow: hidden;
        background-color: var(--background);
        isolation: isolate;
    }

    /* Positioning context for the floating action bar: flex:1 row that holds the
       scrolling .app-content, so the dock can pin to the box bottom and recenter
       when the detail panel narrows the shell. */
    .app-shell {
        flex: 1;
        min-width: 0;
        position: relative;
        display: flex;
    }

    .app-content {
        flex: 1;
        min-width: 0;
        box-sizing: border-box;
        margin: var(--spacing-03) var(--spacing-03) var(--spacing-03) 0;
        border: 0.5px solid var(--border-muted);
        border-radius: var(--spacing-06);
        background-color: var(--background-high-contrast);
        overflow-y: auto;
        position: relative;
    }
    .app-content::after {
        content: "";
        position: sticky;
        bottom: 0;
        left: 0;
        display: block;
        height: 4rem;
        margin-top: -3rem;
        pointer-events: none;
        -webkit-backdrop-filter: blur(var(--blur-medium));
        backdrop-filter: blur(var(--blur-medium));
        background: linear-gradient(to bottom, transparent, var(--background-high-contrast));
        -webkit-mask-image: linear-gradient(to bottom, transparent, black);
        mask-image: linear-gradient(to bottom, transparent, black);
    }
    @media (max-width: 48rem) {
        .app-content {
            margin: var(--spacing-00);
        }
    }
    .sidebar-backdrop {
        display: none;
    }
    @media (max-width: 48rem) {
        .sidebar-backdrop {
            display: block;
            position: fixed;
            inset: 0;
            z-index: 99;
            opacity: 0;
            pointer-events: none;
            -webkit-backdrop-filter: blur(var(--blur-large));
            backdrop-filter: blur(var(--blur-large));
            transition: opacity var(--duration-medium) var(--ease-smooth-out);
        }
        body.sidebar-open .sidebar-backdrop {
            opacity: 1;
            pointer-events: auto;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .sidebar-backdrop {
            transition: none;
        }
    }
    
    /* Skip link for accessibility */
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        padding: var(--spacing-01) var(--spacing-02);
        background-color: var(--background-high-contrast);
        color: var(--content-secondary-alt);
        text-decoration: none;
        font-weight: 600;
        border-radius: var(--spacing-00);
        z-index: 9999999;
        transition: top 0.2s ease;
        font-size: var(--desktop-caption);
        line-height: var(--lh-desktop-caption);
    }
    
    .skip-link:focus {
        top: var(--spacing-03);
    }

    main {
        margin: var(--spacing-09);
    }
    .container {
        margin: var(--spacing-06);
    }
    section {
        margin-bottom: var(--spacing-10);
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: "ROM-Bold", var(--system-ui);
        font-weight: 500;
    }
    p {
        margin-top: var(--spacing-00);
    }
    .nu-u-link--subtle {
        color: var(--content-secondary) !important;
    }
    .floating-nav {
        padding: var(--spacing-06) var(--spacing-09);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .btn-group {
        display: flex;
        gap: var(--spacing-03);
        align-items: center;
    }
    .submit-btn {
        padding: var(--spacing-02) var(--spacing-05);
        border: 0.5px solid var(--border-muted);
        outline: none;
        text-decoration: none;
        color: var(--content-secondary);
        background-color: var(--background);
        border-radius: var(--spacing-00);
        font-size: var(--desktop-body-sm);
        line-height: var(--lh-desktop-body-sm);
        transition: transform 0.2s ease;

        &:hover {
            background-color: var(--background);
            color: var(--accent);
        }

        &:active {
            background-color: var(--background);
            color: var(--content-secondary);
            transform: scale(0.97);
        }

        &.disabled {
            background-color: var(--background);
            color: var(--content-secondary);
            pointer-events: none;
        }

        &:focus {
            background-color: var(--background);
            outline: 1px solid var(--button-primary);
            color: var(--content-secondary);
        }
    }
    .left-group {
        display: flex;
        align-items: center;
        gap: var(--spacing-05);
    }

    .logo img {
        border-radius: 6px;
    }

    .new-filter-toggle {
        padding: var(--spacing-02) var(--spacing-05);
        border: 0.5px solid var(--border-muted);
        background-color: var(--background);
        color: var(--content-secondary);
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        border-radius: var(--spacing-05);
        font-size: var(--desktop-body-sm);
        line-height: var(--lh-desktop-body-sm);
        transition: transform 0.2s ease;
        outline: none;
    }

    .new-filter-toggle:hover {
        color: var(--accent);
    }

    .new-filter-toggle[aria-pressed="true"] {
        color: var(--accent);
        border-color: var(--accent);
    }

    .new-filter-toggle:active {
        transform: scale(0.97);
    }

    .new-filter-toggle:focus {
        outline: 1px solid var(--button-primary);
        outline-offset: 2px;
    }

    .theme-toggle {
        z-index: 999;
        width: 1.75rem;
        height: 1.75rem;
        background: none;
        border: none;
        padding: var(--spacing-00);
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--spacing-03);
        position: relative;
    }

    .theme-toggle:hover {
        background-color: var(--background-hover);
    }

    .theme-toggle .theme-emoji {
        font-size: 1.25rem;
        line-height: 1;
        display: inline-block;
    }

    html[data-new-ui-theme="aura"] .theme-toggle .theme-emoji::after { content: '🌌'; }
    html[data-new-ui-theme="ayu-dark"] .theme-toggle .theme-emoji::after { content: '🍂'; }
    html[data-new-ui-theme="catppuccin-mocha"] .theme-toggle .theme-emoji::after { content: '🍫'; }
    html[data-new-ui-theme="dracula"] .theme-toggle .theme-emoji::after { content: '🩸'; }
    html[data-new-ui-theme="flexoki-dark"] .theme-toggle .theme-emoji::after { content: '🪶'; }
    html[data-new-ui-theme="monokai"] .theme-toggle .theme-emoji::after { content: '🐠'; }
    html[data-new-ui-theme="night-owl"] .theme-toggle .theme-emoji::after { content: '🦉'; }
    html[data-new-ui-theme="sargam-dark"] .theme-toggle .theme-emoji::after { content: '🪷'; }
    html[data-new-ui-theme="synthwave-84"] .theme-toggle .theme-emoji::after { content: '🚗'; }
    html[data-new-ui-theme="tokyo-night"] .theme-toggle .theme-emoji::after { content: '🌃'; }

    /* Icon swap: blur + scale the emoji as it changes on toggle. */
    @keyframes theme-emoji-swap {
        0% { transform: scale(1); filter: blur(0); opacity: 1; }
        45% { transform: scale(0.7); filter: blur(var(--blur-small)); opacity: 0.5; }
        100% { transform: scale(1); filter: blur(0); opacity: 1; }
    }

    .theme-toggle .theme-emoji.is-swapping {
        animation: theme-emoji-swap var(--duration-fast) var(--ease-in-out);
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle .theme-emoji.is-swapping { animation: none; }
    }

    .theme-toggle:focus {
        outline: 1px solid var(--button-primary);
        outline-offset: 2px;
    }

    .favorites-link {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-02);
        padding: var(--spacing-02) var(--spacing-05);
        border: 0.5px solid var(--border-muted);
        background-color: var(--background);
        color: var(--content-secondary);
        text-decoration: none;
        font-size: var(--desktop-body-sm);
        line-height: var(--lh-desktop-body-sm);
        border-radius: var(--spacing-05);
        outline: none;
        transition: transform 0.2s ease;
    }

    .favorites-link:hover {
        background-color: var(--background);
        color: var(--accent);
    }

    .favorites-link:active {
        background-color: var(--background);
        color: var(--content-secondary);
        transform: scale(0.97);
    }

    .favorites-link:focus {
        background-color: var(--background);
        outline: 1px solid var(--button-primary);
        color: var(--content-secondary);
    }

    .favorites-link svg {
        flex-shrink: 0;
    }

    .favorites-count {
        display: none;
    }

    @media (max-width: 48rem) {
        .favorites-text {
            display: none;
        }

        .favorites-count {
            display: inline;
        }
    }

    .footer p {
        padding-bottom: var(--spacing-10);
        text-align: center;
        font-weight: normal;
        font-style: normal;
        color: var(--content-secondary);
        font-size: var(--desktop-caption);
        line-height: var(--lh-desktop-caption);
        font-family: var(--monospace);
    }

    /* Empty state styles */
    .empty-state {
        text-align: center;
        padding: var(--spacing-15) var(--spacing-06);
        max-width: 40rem;
        margin: 0 auto;
    }

    .empty-state h2 {
        margin-top: var(--spacing-04);
        margin-bottom: var(--spacing-03);
    }

    .back-home-btn {
        padding: var(--spacing-03) var(--spacing-06);
        background-color: var(--accent);
        color: var(--background);
        text-decoration: none;
        font-weight: 600;
        border-radius: var(--spacing-00);
        transition: filter 0.2s ease;
    }

    .back-home-btn:hover {
        filter: brightness(1.1);
    }

    /* Favorites page styles */
    .favorites-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-06);
        flex-wrap: wrap;
        gap: var(--spacing-04);
    }

    .sort-select {
        padding: var(--spacing-02) var(--spacing-04);
        border: 0.5px solid var(--border-muted);
        background-color: var(--background);
        color: var(--content-secondary);
        font-size: var(--desktop-body-sm);
        line-height: var(--lh-desktop-body-sm);
        border-radius: var(--spacing-00);
    }

    .sort-select:hover {
        background-color: var(--background-secondary);
        border-color: var(--border);
    }

    .sort-select:focus {
        outline: 2px solid var(--border-focus);
        outline-offset: 2px;
    }

    @media (max-width: 30rem) {
        main {
            margin: auto var(--spacing-06);
        }
        .floating-nav {
            padding: var(--spacing-06) var(--spacing-06);
        }
        .container {
            margin: var(--spacing-06);
        }
    }

    .legal-content-wrapper {
        max-width: 45rem;
        margin: 0 auto;
        padding: var(--spacing-09);
        border: 0.5px solid var(--border-muted);
    }

    .legal-header {
        margin-bottom: var(--spacing-08);
        border-bottom: 0.5px solid var(--border-muted);
        padding-bottom: var(--spacing-04);
    }

    .last-updated {
        font-family: var(--monospace);
        font-size: var(--desktop-caption);
        color: var(--content-secondary-alt);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .legal-content-wrapper h2 {
        margin: var(--spacing-08) 0 var(--spacing-04) 0;
        font-weight: 600;
    }

    .legal-content-wrapper p,
    .legal-content-wrapper li {
        margin-bottom: var(--spacing-05);
        line-height: var(--lh-desktop-body);
    }

    @media (max-width: 768px) {
        .legal-content-wrapper {
            padding: var(--spacing-06);
            margin: 0 var(--spacing-04);
        }
    }
</style>

<script is:inline>
    (function () {
        const updateFavoritesLink = () => {
            try {
                const countEl = document.getElementById("favoritesCount");
                if (!countEl) return;

                const bookmarksString = localStorage.getItem("rom_bookmarks:v1") || localStorage.getItem("rom_bookmarks");
                const count = bookmarksString
                    ? JSON.parse(bookmarksString).length
                    : 0;

                // Saved is a permanent sidebar item now — only reflect the count.
                countEl.textContent = count > 0 ? String(count) : "";
            } catch (e) {}
        };

        // Core Initialization (Runs on every page load including initial)
        const NEW_PARAM = "new";

        const readNewFromUrl = () => {
            try {
                return new URLSearchParams(window.location.search).get(NEW_PARAM) === "1";
            } catch (e) {
                return false;
            }
        };

        const writeNewToUrl = (on) => {
            try {
                const url = new URL(window.location.href);
                if (on) url.searchParams.set(NEW_PARAM, "1");
                else url.searchParams.delete(NEW_PARAM);
                const next = url.pathname + (url.search ? url.search : "") + url.hash;
                window.history.replaceState(null, "", next);
            } catch (e) {}
        };

        const init = () => {
            // New Tools Filter Toggle - Idempotent listener
            const newFilterToggle =
                document.querySelector("#new-filter-toggle");
            if (newFilterToggle) {
                // Sync button visual state from URL on each page load.
                // Dashboard reads the same URL on mount/page-load, so we
                // don't dispatch from here (which would race React hydration).
                const urlOn = readNewFromUrl();
                newFilterToggle.setAttribute("aria-pressed", String(urlOn));

                if (!newFilterToggle._hasFilterListener) {
                    newFilterToggle.addEventListener("click", () => {
                        const isPressed =
                            newFilterToggle.getAttribute("aria-pressed") ===
                            "true";
                        const next = !isPressed;
                        newFilterToggle.setAttribute(
                            "aria-pressed",
                            next,
                        );
                        writeNewToUrl(next);
                        window.dispatchEvent(
                            new CustomEvent("tools:filter-new", {
                                detail: { filterNew: next },
                            }),
                        );
                    });
                    newFilterToggle._hasFilterListener = true;
                }
            }

            updateFavoritesLink();
        };

        // Theme toggle — cycles through every dark theme from @new-ui/themes.
        const THEMES = [
            { id: 'sargam-dark', label: 'Sargam Dark' },
            { id: 'aura', label: 'Aura' },
            { id: 'ayu-dark', label: 'Ayu Dark' },
            { id: 'catppuccin-mocha', label: 'Catppuccin Mocha' },
            { id: 'dracula', label: 'Dracula' },
            { id: 'flexoki-dark', label: 'Flexoki Dark' },
            { id: 'monokai', label: 'Monokai' },
            { id: 'night-owl', label: 'Night Owl' },
            { id: 'synthwave-84', label: 'Synthwave 84' },
            { id: 'tokyo-night', label: 'Tokyo Night' },
        ];
        const THEME_IDS = THEMES.map((t) => t.id);
        const DEFAULT_THEME = 'flexoki-dark';

        const getSavedTheme = () => {
            try {
                const t = localStorage.getItem('rom_theme');
                return THEME_IDS.includes(t) ? t : DEFAULT_THEME;
            } catch (e) {
                return DEFAULT_THEME;
            }
        };

        const applyTheme = (theme) => {
            document.documentElement.setAttribute('data-new-ui-theme', theme);
            const btn = document.getElementById('theme-toggle');
            if (btn) {
                const meta = THEMES.find((t) => t.id === theme);
                btn.setAttribute('aria-label',
                    `Change theme (current: ${meta ? meta.label : theme})`);
            }
        };

        const initTheme = () => {
            applyTheme(getSavedTheme());

            const themeToggle = document.getElementById('theme-toggle');
            if (themeToggle && !themeToggle._hasThemeListener) {
                themeToggle.addEventListener('click', () => {
                    const current = document.documentElement.getAttribute('data-new-ui-theme');
                    const idx = THEME_IDS.indexOf(current);
                    const next = THEME_IDS[(idx + 1) % THEME_IDS.length];
                    try { localStorage.setItem('rom_theme', next); } catch (e) {}
                    applyTheme(next);
                    const emoji = themeToggle.querySelector('.theme-emoji');
                    if (emoji) {
                        emoji.classList.remove('is-swapping');
                        void emoji.offsetWidth;
                        emoji.classList.add('is-swapping');
                    }
                });
                themeToggle._hasThemeListener = true;
            }
        };

        // Mobile sidebar drawer
        const closeSidebar = () => {
            const wasOpen = document.body.classList.contains('sidebar-open');
            document.body.classList.remove('sidebar-open');
            const t = document.getElementById('sidebar-toggle');
            if (t) {
                t.setAttribute('aria-expanded', 'false');
                if (wasOpen) t.focus();
            }
        };

        const drawerFocusables = () => {
            const bar = document.getElementById('app-sidebar');
            if (!bar) return [];
            return Array.from(
                bar.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
            ).filter((el) => el.offsetParent !== null);
        };

        const initDrawer = () => {
            const toggle = document.getElementById('sidebar-toggle');
            if (toggle && !toggle._hasDrawerListener) {
                toggle.addEventListener('click', () => {
                    const open = document.body.classList.toggle('sidebar-open');
                    toggle.setAttribute('aria-expanded', String(open));
                    if (open) drawerFocusables()[0]?.focus();
                });
                toggle._hasDrawerListener = true;
            }
        };

        // Global Event Listeners (ensure single attachment)
        if (!window.__rom_initialized) {
            window.addEventListener("bookmarks:changed", updateFavoritesLink);
            window.addEventListener("pageshow", updateFavoritesLink);
            document.addEventListener("astro:before-swap", (e) => {
                const theme = getSavedTheme();
                e.newDocument.documentElement.setAttribute('data-new-ui-theme', theme);
            });
            document.addEventListener("astro:page-load", () => { init(); initTheme(); initDrawer(); closeSidebar(); });
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") { closeSidebar(); return; }
                // Trap focus inside the drawer while it's open (mobile).
                if (e.key === "Tab" && document.body.classList.contains("sidebar-open")) {
                    const items = drawerFocusables();
                    if (!items.length) return;
                    const first = items[0];
                    const last = items[items.length - 1];
                    if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
                    else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
                }
            });
            document.addEventListener("click", (e) => {
                const backdrop = document.getElementById("sidebar-backdrop");
                const nav = e.target.closest && e.target.closest("#app-sidebar .sidebar-item[href]");
                if (e.target === backdrop || nav) closeSidebar();
            });
            window.__rom_initialized = true;
        }

        // Initial run for the current page
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => { init(); initTheme(); initDrawer(); });
        } else {
            init();
            initTheme();
            initDrawer();
        }
    })();
</script>
