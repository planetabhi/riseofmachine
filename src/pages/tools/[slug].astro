---
import Layout from "../../layouts/Layout.astro";
import slugMap from "../../data/slug-map.json";
import ToolGrid from "../../components/ToolGrid.astro";
import GridEnhancer from "../../components/GridEnhancer.astro";
import SoftwareApplicationSchema from "../../components/schema/SoftwareApplicationSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import categoryIndex from "../../data/category-index.json";

export async function getStaticPaths() {
  // Use slug-map for efficient path generation (no need to load full tools.json)
  try {
    const slugMapData = await import("../../data/slug-map.json");
    return Object.keys(slugMapData.default).map((slug) => ({ params: { slug } }));
  } catch (e) {
    console.error("Failed to load slug-map.json for static paths:", e);
    throw e;
  }
}

export const prerender = true;

const { slug } = Astro.params;

const categoryList = (slugMap as Record<string, string[]>)[slug as string];
const categoryName = categoryList?.[0];
if (!categoryName) return Astro.redirect("/404");

let categoryData: any;
try {
  categoryData = await import(`../../data/tools/${categoryName}.json`);
} catch (e) {
  console.error(`Failed to load category file for: ${categoryName}`, e);
  return Astro.redirect("/404");
}

const tool = categoryData.default.find((x: any) => x.slug === slug) || null;
if (!tool) return Astro.redirect("/404");

const category = categoryName;
const categoryTitle =
  (categoryIndex as Record<string, { title: string }>)[category]?.title ?? category;
// Render the tool's category as the backdrop; the panel opens over it for this tool.
const categoryTools = categoryData.default.map((t: any) => ({ ...t, category }));

const faviconUrl = `/favicons/${slug}.png`;
// Social scrapers require an absolute URL for og:image / twitter:image.
const socialImageUrl = `https://riseofmachine.com/favicons/${slug}.png`;
const canonicalUrl = `https://riseofmachine.com/tools/${tool.slug}`;

let meta: any = {};
try {
  const toolMetadata = await import(`../../data/tool-metadata/${slug}.json`);
  meta = toolMetadata.default;
} catch (e) {}

const seoTitle = meta.title || tool.title;
const seoDescription = meta.description || tool.body;

const breadcrumbs = [
  { name: "Home", url: "https://riseofmachine.com" },
  { name: categoryTitle, url: `https://riseofmachine.com/${category}` },
  { name: tool.title },
];
---

<Layout
  site={`Rise of Machine - ${tool.title}`}
  title="AI tools curated by autonomous agents for makers and SMBs"
  tagline=""
  pageTitle={seoTitle}
  pageDescription={seoDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={seoTitle}
  ogDescription={seoDescription}
  ogUrl={canonicalUrl}
  ogImage={socialImageUrl}
  ogType="website"
  ogSiteName="Rise of Machine"
  twitterCard="summary"
  twitterTitle={seoTitle}
  twitterDescription={seoDescription}
  twitterImage={socialImageUrl}
  pageFavicon={faviconUrl}
  showLatestFilter={false}
  showSearch={true}
  showHero={true}
>
  <SoftwareApplicationSchema
    name={tool.title}
    description={tool.body}
    url={tool.url}
    tag={tool.tag}
    dateAdded={tool["date-added"]}
    category={category}
  />
  <BreadcrumbSchema items={breadcrumbs} />
  <main id="main-content">
    <noscript>
      <section class="tool-fallback">
        <h2>{tool.title}</h2>
        <p>{seoDescription}</p>
        <a href={tool.url} target="_blank" rel="noopener noreferrer">Visit {tool.title} ↗</a>
      </section>
    </noscript>
    <ToolGrid tools={categoryTools} />
    <GridEnhancer />
  </main>
</Layout>
