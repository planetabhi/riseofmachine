---
import Layout from "../layouts/Layout.astro";

import CardList from "../components/CardList.astro";
import HomeEnhancer from "../components/HomeEnhancer.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import data from "../data/tools.json";
import { seededShuffle } from "../utils/sorting";

// Flatten all tools, tagging each with its category.
const allTools = data.tools.flatMap((category: any) =>
  category.content.map((tool: any) => ({ ...tool, category: category.category }))
);

// Newest first for the "Latest" strip; a stable sample for "Featured".
const latestTools = [...allTools]
  .sort(
    (a: any, b: any) =>
      new Date(b["date-added"]).getTime() - new Date(a["date-added"]).getTime()
  )
  .slice(0, 12);

const featuredSlugs = ["chatgpt", "midjourney", "cursor", "elevenlabs"];
const featuredTools = featuredSlugs
  .map((slug) => allTools.find((tool: any) => tool.slug === slug))
  .filter(Boolean);
if (featuredTools.length < 4) {
  featuredTools.push(
    ...seededShuffle(allTools, 20260801)
      .filter((tool: any) => !featuredSlugs.includes(tool.slug))
      .slice(0, 4 - featuredTools.length)
  );
}
---

<Layout
  site="Rise of Machine"
  title="AI tools curated by autonomous agents for makers and SMBs"
  tagline=""
  showSearch={true}
  showHero={true}
>
  <OrganizationSchema />
  <ItemListSchema items={latestTools} listName="AI Tools Directory - Latest" />
  <main id="main-content">
    <section class="home-section" id="section-featured">
      <h2 class="home-section-title">Featured</h2>
      <CardList tools={featuredTools} />
    </section>

    <section class="home-section" id="section-latest">
      <h2 class="home-section-title">Latest</h2>
      <CardList tools={latestTools} />
    </section>

    <section class="home-section" id="section-all">
      <h2 class="home-section-title" id="section-all-title">Home</h2>
      <ul id="home-all-grid" role="list" class="link-card-grid"></ul>
      <noscript>
        <p class="nu-u-text--secondary">
          Enable JavaScript to browse the full catalogue, or pick a category from the sidebar.
        </p>
      </noscript>
      <div class="grid-sentinel" id="home-sentinel"></div>
      <div class="grid-empty" hidden>
        <p class="nu-u-text--secondary">No results found.</p>
      </div>
    </section>

    <HomeEnhancer />
  </main>
</Layout>

<script>
  // 3D hover tilt on the Featured cards (desktop pointers only so mobile
  // scrolling isn't captured). Reuses the shipped `t-tilt` CSS.
  function initFeaturedTilt() {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const MAX = 6;
    document
      .querySelectorAll<HTMLElement>('#section-featured .link-card')
      .forEach((card) => {
        if (card.dataset.tiltBound) return;
        card.dataset.tiltBound = '1';
        card.classList.add('t-tilt', 't-tilt-card');
        const glare = document.createElement('span');
        glare.className = 't-tilt-glare';
        card.appendChild(glare);
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.setProperty('--tilt-ry', `${(px - 0.5) * MAX * 2}deg`);
          card.style.setProperty('--tilt-rx', `${(0.5 - py) * MAX * 2}deg`);
          card.style.setProperty('--tilt-gx', `${px * 100}%`);
          card.style.setProperty('--tilt-gy', `${py * 100}%`);
          card.classList.add('is-tilting', 'is-hover');
        });
        card.addEventListener('pointerleave', () => {
          card.classList.remove('is-tilting', 'is-hover');
          card.style.setProperty('--tilt-rx', '0deg');
          card.style.setProperty('--tilt-ry', '0deg');
        });
      });
  }
  document.addEventListener('astro:page-load', initFeaturedTilt);
</script>


<style>
  .home-section {
    margin-bottom: var(--spacing-10);
  }

  .home-section-title {
    margin: 0 0 var(--spacing-05) 0;
    font-size: var(--desktop-body);
    line-height: var(--lh-desktop-body);
    color: var(--content-secondary);
  }
</style>
