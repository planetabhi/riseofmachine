---
import Layout from '../../../layouts/Layout.astro';
import McpControls from '../../../components/McpControls.astro';
import McpGrid from '../../../components/McpGrid.astro';
import McpEnhancer from '../../../components/McpEnhancer.astro';
import McpDetailPanel from '../../../components/McpDetailPanel.astro';
import SoftwareApplicationSchema from '../../../components/schema/SoftwareApplicationSchema.astro';
import BreadcrumbSchema from '../../../components/schema/BreadcrumbSchema.astro';
import mcpData from '../../../data/mcp-servers.json';
import mcpIndex from '../../../data/mcp-category-index.json';
import type { McpData, McpServer, McpCategoryIndex } from '../../../types/mcp';

export function getStaticPaths() {
    const data = mcpData as McpData;
    return data.servers.map((s) => ({ params: { slug: s.slug }, props: { server: s } }));
}

export const prerender = true;

interface Props {
    server: McpServer;
}
const { server } = Astro.props as Props;
const index = mcpIndex as McpCategoryIndex;

// Render the server's category listing as the backdrop; the RHS panel opens over
// it for this server on load (same model as /tools/{slug}). No standalone page.
const category = server.category;
const categoryTitle = index[category]?.title ?? category;
const canonicalUrl = `https://riseofmachine.com/mcp/servers/${server.slug}`;

const breadcrumbs = [
    { name: 'MCP Servers', url: 'https://riseofmachine.com/mcp' },
    { name: categoryTitle, url: `https://riseofmachine.com/mcp/${category}` },
    { name: server.title },
];
---

<Layout
    site={`Rise of Machine - ${server.title}`}
    title={`${categoryTitle} MCP Servers`}
    tagline=""
    pageTitle={`${server.title} — MCP Server`}
    pageDescription={server.description}
    canonicalUrl={canonicalUrl}
    ogTitle={`${server.title} — MCP Server`}
    ogDescription={server.description}
    ogUrl={canonicalUrl}
    ogType="website"
    ogSiteName="Rise of Machine"
    twitterCard="summary"
    showSearch={true}
    showHero={true}
    searchPlaceholder={`Search ${categoryTitle} servers...`}
    sidebarCategoryIndex={index}
    sidebarBasePath="/mcp"
    sidebarHomeHref="/mcp"
    sidebarHomeLabel="MCP Servers"
    sidebarShowFavorites={false}
    sidebarPersistKey="mcp-sidebar"
>
    <SoftwareApplicationSchema
        name={server.title}
        description={server.description}
        url={server.url}
        dateAdded={server.publishedAt}
        category={category}
    />
    <BreadcrumbSchema items={breadcrumbs} />
    <main id="main-content">
        <noscript>
            <section class="mcp-fallback">
                <h2>{server.title}</h2>
                <p>{server.description}</p>
                {server.installCommand && <pre class="mcp-fallback-cmd">{server.installCommand}</pre>}
                <ul>
                    {server.websiteUrl && (
                        <li><a href={server.websiteUrl} target="_blank" rel="noopener nofollow">Website ↗</a></li>
                    )}
                    {server.repository?.url && (
                        <li><a href={server.repository.url} target="_blank" rel="noopener nofollow">Repository ↗</a></li>
                    )}
                    <li><a href={`/mcp/${category}`}>All {categoryTitle} servers</a></li>
                </ul>
            </section>
        </noscript>
        <McpControls />
        <McpGrid category={category} />
        <McpEnhancer />
    </main>
    <McpDetailPanel slot="side-panel" />
</Layout>

<style>
    .mcp-fallback {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-04);
        max-width: 60ch;
    }
    .mcp-fallback-cmd {
        margin: 0;
        padding: var(--spacing-03) var(--spacing-04);
        background-color: var(--background-secondary);
        border-radius: var(--spacing-03);
        font-family: var(--monospace);
        font-size: var(--desktop-caption);
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>
