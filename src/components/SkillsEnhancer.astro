---
// Client-rendered Skills grid: fetches the compact /skills-index.json once (or a
// /skills-cat/{topic}.json shard on category routes), then searches in memory and
// renders 48 cards at a time (progressive reveal via IntersectionObserver). Cards
// carry data-* + data-skill-link so SkillsDetailPanel opens the RHS panel with
// zero extra fetch. Keeps the listing HTML tiny (no SSR cards).
---

<script>
    type Rec = { s: string; src: string; b: string; c: string; ic: string; u: string };

    const PAGE = 48;

    let records: Rec[] = [];
    const recCache = new Map<string, Rec[]>(); // per-URL cache (full index + shards)
    const inflight = new Map<string, Promise<Rec[]>>();
    let scoped: Rec[] = []; // records for this page's category (or all)
    let view: Rec[] = []; // scoped + search
    let rendered = 0;
    let io: IntersectionObserver | null = null;
    let catTitles: Record<string, string> = {};
    let query = '';

    const gridEl = () => document.querySelector<HTMLElement>('[data-skills-grid]');
    const listEl = () => gridEl()?.querySelector<HTMLElement>('[data-skills-list]') ?? null;
    const sentinelEl = () => gridEl()?.querySelector<HTMLElement>('.grid-sentinel') ?? null;
    const emptyEl = () => gridEl()?.querySelector<HTMLElement>('.grid-empty') ?? null;
    const pageCategory = () => gridEl()?.dataset.category || '';

    // Category pages load a small per-category shard; the landing loads the full
    // index (it searches across every skill).
    const indexUrl = () => {
        const cat = pageCategory();
        return cat ? `/skills-cat/${cat}.json` : '/skills-index.json';
    };

    async function loadRecords(url: string): Promise<Rec[]> {
        const cached = recCache.get(url);
        if (cached) return cached;
        let p = inflight.get(url);
        if (!p) {
            p = fetch(url)
                .then((r) => {
                    if (!r.ok) throw new Error(`skills index ${r.status}`);
                    return r.json();
                })
                .then((d: Rec[]) => {
                    recCache.set(url, d);
                    inflight.delete(url);
                    return d;
                })
                .catch(() => {
                    inflight.delete(url);
                    return [] as Rec[];
                });
            inflight.set(url, p);
        }
        return p;
    }

    // Category slug -> title, read from the sidebar (zero extra fetch).
    function buildCatMap() {
        catTitles = {};
        document.querySelectorAll<HTMLAnchorElement>('#app-sidebar .sidebar-nav a').forEach((a) => {
            try {
                const slug = new URL(a.href).pathname
                    .replace(/^\/skills\//, '')
                    .replace(/^\//, '')
                    .replace(/\/$/, '');
                const label = a.querySelector('.sidebar-item-label')?.textContent?.trim();
                if (slug && label) catTitles[slug] = label;
            } catch {}
        });
    }

    function matches(r: Rec): boolean {
        if (query.length >= 2) {
            const hay = `${r.s} ${r.b} ${r.src}`.toLowerCase();
            if (!hay.includes(query)) return false;
        }
        return true;
    }

    function cardEl(r: Rec): HTMLLIElement {
        const catTitle = catTitles[r.c] ?? r.c;

        const li = document.createElement('li');
        li.className = 'link-card is-revealing';
        li.dataset.slug = r.s;
        li.dataset.category = r.c;

        const a = document.createElement('a');
        a.href = `/skills/${r.src}/${r.s}`;
        a.setAttribute('data-skill-link', '');
        a.dataset.title = r.s;
        a.dataset.body = r.b;
        a.dataset.url = r.u;
        a.dataset.slug = r.s;
        a.dataset.source = r.src;
        a.dataset.category = r.c;
        a.dataset.categoryTitle = catTitle;
        a.dataset.installCommand = r.ic;

        const strong = document.createElement('strong');
        strong.className = 'nu-c-fs-normal nu-u-mt-1 nu-u-mb-1';
        strong.textContent = r.s;

        const body = document.createElement('p');
        body.className = 'nu-c-helper-text nu-u-mt-1 nu-u-mb-1';
        body.textContent = r.b;

        a.append(strong, body);

        li.appendChild(a);
        return li;
    }

    function renderMore() {
        const list = listEl();
        if (!list) return;
        const next = view.slice(rendered, rendered + PAGE);
        if (next.length) {
            const frag = document.createDocumentFragment();
            next.forEach((r) => frag.appendChild(cardEl(r)));
            list.appendChild(frag);
            rendered += next.length;
        }
        const sentinel = sentinelEl();
        if (sentinel) sentinel.hidden = rendered >= view.length;
    }

    function recompute() {
        const list = listEl();
        if (!list) return;
        view = scoped.filter(matches).toSorted((a, b) => a.s.localeCompare(b.s));
        list.replaceChildren();
        rendered = 0;
        renderMore();
        const empty = emptyEl();
        if (empty) empty.hidden = view.length !== 0;
    }

    function scope() {
        const cat = pageCategory();
        scoped = cat ? records.filter((r) => r.c === cat) : records;
    }

    function setupObserver() {
        io?.disconnect();
        const sentinel = sentinelEl();
        if (!sentinel) return;
        io = new IntersectionObserver(
            (entries) => {
                if (!entries[0]?.isIntersecting) return;
                if (rendered >= view.length) return;
                renderMore();
            },
            { root: document.querySelector('.app-content'), rootMargin: '400px' },
        );
        io.observe(sentinel);
    }

    function writeUrl() {
        try {
            const p = new URLSearchParams();
            if (query) p.set('q', query);
            const qs = p.toString();
            history.replaceState(history.state, '', qs ? `?${qs}` : location.pathname);
        } catch {
            /* history unavailable */
        }
    }

    function readUrl() {
        try {
            const p = new URLSearchParams(location.search);
            query = (p.get('q') ?? '').trim().toLowerCase();
        } catch {
            /* ignore */
        }
    }

    async function init() {
        if (!gridEl()) return;
        query = '';
        buildCatMap();
        readUrl();
        records = await loadRecords(indexUrl());
        if (!gridEl()) return; // navigated away while loading
        scope();
        setupObserver();
        recompute();
    }

    if (!(window as any).__skillsEnhancerBound) {
        (window as any).__skillsEnhancerBound = true;

        // Inline search box (ContentTopbar/Hero dispatch this shared event).
        window.addEventListener('tools:search', (e: Event) => {
            const detail = (e as CustomEvent<{ query?: string }>).detail || {};
            if (typeof detail.query === 'string' && gridEl()) {
                query = detail.query.trim().toLowerCase();
                recompute();
                writeUrl();
            }
        });

        document.addEventListener('astro:page-load', () => void init());
        void init();
    }
</script>
