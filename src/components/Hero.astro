---
import SearchInput from './SearchInput.astro';
import HeroAsciiBackground from './HeroAsciiBackground.astro';

interface Props {
    title: string;
    tagline: string;
    showSearch?: boolean;
    searchPlaceholder?: string;
}

const {
    title,
    tagline,
    showSearch = false,
    searchPlaceholder = 'Search by name, category, or feature...',
} = Astro.props;
---

<div class="hero-shell">
    <HeroAsciiBackground />
    <div class="hero">
        <h1 class="hero-title nu-c-h5 nu-u-text--primary">{title}</h1>
        <p class="hero-tagline nu-u-text--secondary">{tagline}</p>
        {showSearch && (
            <div class="hero-search">
                <SearchInput placeholder={searchPlaceholder} />
            </div>
        )}
    </div>
</div>

<style>
    /* A local stacking context keeps the ASCII field layered inside the hero,
       above the opaque .app-content background but below the hero text. The BFC
       from overflow also contains the hero's margins so the field spans them.
       min-height turns the hero into a banner the field flows across before it
       fades out, so it never cuts off abruptly above the content below. */
    .hero-shell {
        position: relative;
        isolation: isolate;
        overflow: hidden;
    }

    .hero {
        position: relative;
        z-index: 1;
        text-align: left;
        max-width: 24rem;
        margin: var(--spacing-12) var(--spacing-09);
        padding-inline: var(--spacing-06);
    }

    .hero-title {
        margin: 0 0 var(--spacing-03);
    }

    .hero-tagline {
        margin: 0 0 var(--spacing-06);
    }

    .hero-search {
        display: flex;
        justify-content: flex-start;
        /* Reclaim the hero's horizontal padding so the search can reach 24rem. */
        margin-inline: calc(-1 * var(--spacing-06));
    }

    .hero-search :global(.search-container) {
        margin-top: 0;
        width: 100%;
    }

    .hero-search :global(.search-input-wrapper) {
        margin-inline: 0;
    }
</style>
