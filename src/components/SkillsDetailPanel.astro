---
// Inline (non-modal) Skill detail panel — the Skills analogue of McpDetailPanel.
// Slides in as a flex sibling of .app-content, populated entirely from the
// clicked card's data-* (zero fetch). Opening updates the URL to
// /skills/{source}/{slug} (Back closes). Keyed off a[data-skill-link] so it
// never conflicts with the tools or MCP panels. Text-first: no icons.
---

<aside class="detail-panel skills-detail-panel" id="skills-detail-panel" aria-label="Skill details" aria-hidden="true" inert>
    <div class="detail-panel-inner">
        <div class="detail-head">
            <span class="detail-monogram" id="skills-detail-monogram" aria-hidden="true"></span>
            <div class="detail-head-actions">
                <button type="button" class="detail-close" id="skills-detail-close" aria-label="Close panel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
        </div>

        <h2 class="detail-title nu-c-h5 nu-u-text--primary" id="skills-detail-title"></h2>
        <div class="detail-meta">
            <span class="detail-added" id="skills-detail-source"></span>
        </div>

        <section class="detail-section" id="skills-detail-cmd-section" hidden>
            <p class="detail-label">Install command</p>
            <div class="detail-cmd-wrap">
                <code class="detail-cmd" id="skills-detail-cmd"></code>
                <button type="button" class="detail-cmd-copy" id="skills-detail-copy" aria-label="Copy install command">
                    <svg class="detail-cmd-icon icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
                        <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <svg class="detail-cmd-icon icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </section>

        <section class="detail-section">
            <p class="detail-label">About</p>
            <p class="detail-body nu-u-text--secondary" id="skills-detail-body"></p>
        </section>

        <section class="detail-section" id="skills-detail-links-section" hidden>
            <p class="detail-label">Links</p>
            <a class="detail-value detail-link" id="skills-detail-repo" target="_blank" rel="noopener noreferrer nofollow"></a>
        </section>
    </div>
</aside>

<style>
    .detail-panel {
        flex-shrink: 0;
        width: 0;
        overflow: hidden;
        box-sizing: border-box;
        background-color: var(--background-high-contrast);
        transition: width var(--resize-dur) var(--resize-ease);
        will-change: width;
    }

    .detail-panel.is-open {
        width: 33vw;
        margin: var(--spacing-03) var(--spacing-03) var(--spacing-03) 0;
        border: 0.5px solid var(--border-muted);
        border-radius: var(--spacing-06);
    }

    .detail-panel-inner {
        width: 33vw;
        box-sizing: border-box;
        height: 100%;
        overflow-y: auto;
        padding: var(--spacing-06) var(--spacing-06);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-05);
    }

    .detail-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .detail-monogram {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: var(--spacing-02);
        background-color: var(--background-secondary);
        color: var(--content-secondary);
        font-family: var(--monospace);
        font-size: var(--desktop-body);
        text-transform: uppercase;
    }

    .detail-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--spacing-08);
        height: var(--spacing-08);
        padding: var(--spacing-01);
        border: none;
        border-radius: var(--spacing-02);
        background: none;
        color: var(--content-secondary);
        cursor: var(--c-pointer);
    }

    .detail-close:hover {
        background-color: var(--background-hover);
        color: var(--content-primary);
    }

    .detail-close:focus-visible {
        outline: 1px solid var(--button-primary);
        outline-offset: -1px;
    }

    .detail-title {
        margin: 0;
        word-break: break-word;
    }

    .detail-meta {
        display: flex;
        align-items: center;
        gap: var(--spacing-02);
        flex-wrap: wrap;
        color: var(--content-secondary);
        font-size: var(--desktop-caption);
        line-height: var(--lh-desktop-caption);
        margin-bottom: var(--spacing-06);
    }

    .detail-section {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-02);
    }

    .detail-label {
        margin: 0;
        color: var(--content-secondary-alt);
        font-family: var(--monospace);
        font-size: var(--desktop-caption);
        line-height: var(--lh-desktop-caption);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .detail-body {
        margin: 0;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
    }

    .detail-more {
        color: var(--accent);
        cursor: var(--c-pointer);
        white-space: nowrap;
    }

    .detail-more:hover {
        text-decoration: underline;
    }

    .detail-more:focus-visible {
        outline: 1px solid var(--button-primary);
        outline-offset: 1px;
    }

    .detail-value {
        margin: 0;
        color: var(--content-secondary);
        font-size: var(--desktop-body-sm);
        line-height: var(--lh-desktop-body-sm);
        word-break: break-word;
    }

    .detail-cmd {
        display: block;
        box-sizing: border-box;
        width: 100%;
        padding: var(--spacing-03) var(--spacing-04);
        border: .5px solid var(--border-muted);
        background-color: var(--background-secondary);
        color: var(--support-success);
        font-family: var(--monospace);
        font-size: var(--desktop-code);
        line-height: var(--lh-desktop-code);
        white-space: pre-wrap;
        word-break: break-all;
    }

    .detail-cmd-wrap {
        position: relative;
    }

    .detail-cmd-wrap .detail-cmd {
        padding-right: var(--spacing-08);
    }

    .detail-cmd-copy {
        position: absolute;
        top: var(--spacing-02);
        right: var(--spacing-02);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--spacing-07);
        height: var(--spacing-07);
        padding: 0;
        border: none;
        border-radius: var(--spacing-02);
        background: none;
        color: var(--content-secondary);
        cursor: var(--c-pointer);
    }

    .detail-cmd-copy:hover {
        background-color: var(--background-hover);
        color: var(--content-primary);
    }

    .detail-cmd-copy:focus-visible {
        outline: 1px solid var(--button-primary);
        outline-offset: -1px;
    }

    .detail-cmd-copy .icon-check {
        display: none;
        color: var(--accent);
    }

    .detail-cmd-copy.is-copied .icon-copy {
        display: none;
    }

    .detail-cmd-copy.is-copied .icon-check {
        display: inline;
    }

    .detail-link {
        color: var(--accent);
        text-decoration: none;
    }

    .detail-link:hover {
        text-decoration: underline;
    }

    @media (max-width: 48rem) {
        .detail-panel {
            position: fixed;
            right: 0;
            top: 0;
            height: 100vh;
            z-index: 200;
        }

        .detail-panel.is-open {
            width: 100%;
            margin: 0;
            border: none;
            border-radius: 0;
        }

        .detail-panel-inner {
            width: 100vw;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .detail-panel {
            transition: none;
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    let lastFocus: HTMLElement | null = null;
    let pushed = false;
    let openCategory = '';
    let originUrl = '';
    let currentCommand = '';
    let retryTimer = 0;

    // About truncation state (word based, with a show more/less toggle).
    const ABOUT_WORD_LIMIT = 45;
    let aboutFull = '';
    let aboutTruncated = '';
    let aboutNeedsToggle = false;
    let aboutExpanded = false;

    function applyAbout() {
        const body = document.getElementById('skills-detail-body');
        if (!body) return;
        body.replaceChildren();
        if (!aboutNeedsToggle) {
            body.textContent = aboutFull;
            return;
        }
        // Inline toggle link at the end of the text (built as a node, never innerHTML).
        body.append(document.createTextNode(aboutExpanded ? `${aboutFull} ` : `${aboutTruncated}… `));
        const toggle = document.createElement('a');
        toggle.className = 'detail-more';
        toggle.setAttribute('role', 'button');
        toggle.tabIndex = 0;
        toggle.setAttribute('aria-expanded', String(aboutExpanded));
        toggle.textContent = aboutExpanded ? 'Show less' : 'Show more';
        body.append(toggle);
    }

    function toggleAbout() {
        aboutExpanded = !aboutExpanded;
        applyAbout();
        document.querySelector<HTMLElement>('.detail-more')?.focus();
    }

    function renderAbout(text: string) {
        aboutFull = text;
        const words = text.split(/\s+/).filter(Boolean);
        aboutNeedsToggle = words.length > ABOUT_WORD_LIMIT;
        aboutTruncated = aboutNeedsToggle ? words.slice(0, ABOUT_WORD_LIMIT).join(' ') : text;
        aboutExpanded = false;
        applyAbout();
    }

    const panelEl = () => document.getElementById('skills-detail-panel');
    const isOpen = () => !!panelEl()?.classList.contains('is-open');

    const setText = (id: string, value: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
    };

    const safeDecode = (value: string) => {
        try {
            return decodeURIComponent(value);
        } catch {
            return value;
        }
    };

    function populate(link: HTMLAnchorElement) {
        const d = link.dataset;
        setText('skills-detail-title', d.title ?? '');
        renderAbout(d.body || 'No description provided.');
        // Source is "owner/repo"; show only the owner, prefixed.
        const owner = (d.source ?? '').split('/')[0] ?? '';
        setText('skills-detail-source', owner ? `By: ${owner}` : '');

        // Primary action — copy the install command (zero navigation).
        currentCommand = d.installCommand || '';
        const cmdSection = document.getElementById('skills-detail-cmd-section');
        const cmd = document.getElementById('skills-detail-cmd');
        const copyBtn = document.getElementById('skills-detail-copy');
        if (cmdSection && cmd) {
            cmd.textContent = currentCommand;
            cmdSection.hidden = !currentCommand;
        }
        if (copyBtn) copyBtn.classList.remove('is-copied');

        // Links — source repository on GitHub.
        const repo = document.getElementById('skills-detail-repo') as HTMLAnchorElement | null;
        const linksSection = document.getElementById('skills-detail-links-section');
        const repoHref = d.source ? `https://github.com/${d.source}` : '';
        if (repo) {
            if (repoHref) {
                repo.textContent = `Source (${d.source})`;
                repo.href = repoHref;
                repo.hidden = false;
            } else {
                repo.hidden = true;
            }
        }
        if (linksSection) linksSection.hidden = !repoHref;

        // Monogram (first letter of the slug) stands in for the absent icon.
        const mono = document.getElementById('skills-detail-monogram');
        if (mono) mono.textContent = (d.title?.trim()[0] ?? '?').toUpperCase();
    }

    async function copyCommand() {
        if (!currentCommand) return;
        const btn = document.getElementById('skills-detail-copy');
        let okCopy = false;
        try {
            await navigator.clipboard.writeText(currentCommand);
            okCopy = true;
        } catch {
            try {
                const ta = document.createElement('textarea');
                ta.value = currentCommand;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                okCopy = document.execCommand('copy');
                document.body.removeChild(ta);
            } catch {
                okCopy = false;
            }
        }
        if (btn && okCopy) {
            btn.classList.add('is-copied');
            btn.setAttribute('aria-label', 'Copied');
            window.setTimeout(() => {
                btn.classList.remove('is-copied');
                btn.setAttribute('aria-label', 'Copy install command');
            }, 1600);
        }
    }

    function showPanel(link: HTMLAnchorElement, opts: { push: boolean; focus: boolean }) {
        const panel = panelEl();
        if (!panel) return;
        const switching = isOpen();
        if (!switching) lastFocus = document.activeElement as HTMLElement;
        populate(link);
        openCategory = link.dataset.category ?? '';
        panel.classList.add('is-open');
        panel.removeAttribute('inert');
        panel.setAttribute('aria-hidden', 'false');
        panel.querySelector('.detail-panel-inner')?.scrollTo(0, 0);
        if (switching) {
            const inner = panel.querySelector('.detail-panel-inner');
            if (inner) {
                inner.classList.remove('t-page-enter');
                void (inner as HTMLElement).offsetWidth;
                inner.classList.add('t-page-enter');
            }
        }
        if (opts.focus) document.getElementById('skills-detail-close')?.focus();
        if (opts.push) {
            const href = link.getAttribute('href') ?? undefined;
            try {
                if (pushed) history.replaceState({ romSkillsPanel: true }, '', href);
                else {
                    history.pushState({ romSkillsPanel: true }, '', href);
                    pushed = true;
                }
            } catch {
                /* history unavailable */
            }
        }
    }

    function openPanel(link: HTMLAnchorElement) {
        if (!isOpen()) originUrl = location.pathname + location.search;
        showPanel(link, { push: true, focus: true });
    }

    function hidePanel() {
        const panel = panelEl();
        if (!panel) return;
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        panel.setAttribute('inert', '');
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    function requestClose() {
        if (pushed) {
            pushed = false;
            hidePanel();
            try {
                history.replaceState(null, '', originUrl || (openCategory ? `/skills/${openCategory}` : '/skills'));
            } catch {
                /* history unavailable */
            }
        } else if (/^\/skills\/[^/]+\/[^/]+\/[^/]+\/?$/.test(location.pathname)) {
            navigate('/skills');
        } else {
            hidePanel();
        }
    }

    // Find a rendered card anchor for a given source+slug (cards are client-rendered).
    const cardFor = (source: string, slug: string) =>
        document.querySelector<HTMLAnchorElement>(
            `a[data-skill-link][data-source="${CSS.escape(source)}"][data-slug="${CSS.escape(slug)}"]`,
        );

    function syncFromUrl(push: boolean) {
        pushed = false;
        if (retryTimer) { window.clearInterval(retryTimer); retryTimer = 0; }
        // Detail URLs are /skills/{owner}/{repo}/{slug} — source always has a slash.
        const m = location.pathname.match(/^\/skills\/(.+)\/([^/]+)\/?$/);
        if (m && m[1] && m[2] && m[1].includes('/')) {
            const source = safeDecode(m[1]);
            const slug = safeDecode(m[2]);
            const card = cardFor(source, slug);
            if (card) {
                showPanel(card, { push: false, focus: false });
                return;
            }
            // Card not yet rendered (client grid still loading): retry shortly.
            let tries = 0;
            retryTimer = window.setInterval(() => {
                tries += 1;
                const c = cardFor(source, slug);
                if (c) {
                    window.clearInterval(retryTimer);
                    retryTimer = 0;
                    showPanel(c, { push: false, focus: false });
                } else if (tries > 40) {
                    window.clearInterval(retryTimer);
                    retryTimer = 0;
                }
            }, 100);
            return;
        }
        if (!push && isOpen()) hidePanel();
    }

    if (!(window as any).__skillsDetailPanelBound) {
        (window as any).__skillsDetailPanelBound = true;

        document.addEventListener(
            'click',
            (e) => {
                const target = e.target as HTMLElement;
                if (target.closest('#skills-detail-close')) {
                    e.preventDefault();
                    requestClose();
                    return;
                }
                if (target.closest('#skills-detail-copy')) {
                    e.preventDefault();
                    void copyCommand();
                    return;
                }
                if (target.closest('.detail-more')) {
                    e.preventDefault();
                    toggleAbout();
                    return;
                }
                const link = target.closest<HTMLAnchorElement>('a[data-skill-link]');
                if (!link) return;
                if (e.defaultPrevented) return;
                const me = e as MouseEvent;
                if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
                e.preventDefault();
                e.stopPropagation();
                openPanel(link);
            },
            true,
        );

        window.addEventListener('popstate', () => syncFromUrl(false));
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen()) {
                requestClose();
                return;
            }
            const t = e.target as HTMLElement;
            if ((e.key === 'Enter' || e.key === ' ') && t.closest('.detail-more')) {
                e.preventDefault();
                toggleAbout();
            }
        });
        document.addEventListener('astro:page-load', () => syncFromUrl(true));
    }
</script>
