---
import './Card.css';
import './BookmarkButton.css';
import { isRecentlyAdded } from '../utils/dates';
import defaultCategoryIndex from '../data/category-index.json';

type CategoryIndex = Record<string, { title: string }>;

interface Props {
    title: string;
    body: string;
    tag?: string | undefined;
    dateAdded?: string | undefined;
    slug?: string | undefined;
    url: string;
    category?: string | undefined;
    // Vertical generalization: default to the tools vertical, override for MCP.
    hrefBase?: string; // detail link base (default '/tools')
    categoryIndex?: CategoryIndex; // resolves the category title (default tools index)
    showBookmark?: boolean; // MCP v1 passes false (bookmarking is tools-only)
    // Emit data-tool-link so the tools DetailPanel intercepts the click. MCP v1
    // passes false so its cards navigate to the full detail page instead.
    panelLink?: boolean;
    // Attribute the panel listener keys off. Tools use 'data-tool-link'; MCP
    // cards pass 'data-mcp-link' so the MCP panel (not the tools one) intercepts.
    panelAttr?: string;
    // Optional extra data-* for the detail panel (MCP: install command, badges…).
    extraData?: Record<string, string | undefined>;
}

const {
    title,
    body,
    tag,
    dateAdded,
    slug,
    url,
    category,
    hrefBase = '/tools',
    categoryIndex = defaultCategoryIndex as CategoryIndex,
    showBookmark = true,
    panelLink = true,
    panelAttr = 'data-tool-link',
    extraData = {},
} = Astro.props;

const linkUrl = slug ? `${hrefBase}/${slug}` : url;
const isNew = isRecentlyAdded(dateAdded, 30);
const categoryTitle = category ? (categoryIndex[category]?.title ?? category) : '';
const panelData = panelLink ? { [panelAttr]: '' } : {};
---

<li class="link-card" data-slug={slug} data-category={category} data-new={isNew ? 'true' : 'false'}>
    <a
        href={linkUrl}
        {...panelData}
        data-title={title}
        data-body={body}
        data-tag={tag}
        data-date={dateAdded}
        data-url={url}
        data-slug={slug}
        data-category={category}
        data-category-title={categoryTitle}
        {...extraData}
    >
        <strong class="nu-c-fs-normal nu-u-mt-1 nu-u-mb-1">{title}</strong>
        <p class="nu-c-helper-text nu-u-mt-1 nu-u-mb-1">{body}</p>
        <p class="distribution">
            {isNew && (
                <span class="tag nu-u-me-2 tag-new t-badge" data-open="true" title="Recently added" aria-label="New item">
                    <span class="t-badge-dot">🔥</span>
                </span>
            )}
            {tag && <span class="tag">{tag}</span>}
        </p>
    </a>
    {slug && showBookmark && (
        <div class="card-bookmark">
            <button
                class="bookmark-btn bookmark-btn--small t-like"
                type="button"
                data-bookmark
                data-slug={slug}
                data-title={title}
                aria-label={`Add ${title} to saved list`}
                title={`Add ${title} to saved list`}
            >
                <span class="t-like-icon">
                    <svg class="t-like-heart" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M15 19L9.80769 17.0435L5 19V1H15V19Z" stroke="currentColor" stroke-miterlimit="10" />
                    </svg>
                </span>
            </button>
        </div>
    )}
</li>
