---
import { serializeJsonLd } from "../../utils/jsonLd";

interface Tool {
    title: string;
    body: string;
    url: string;
    slug?: string;
    tag?: string;
}

interface Props {
    items: Tool[];
    listName: string;
    // On-site detail base for the ListItem URL (MCP passes '/mcp/servers').
    urlBase?: string;
}

const { items, listName, urlBase = '/tools' } = Astro.props;

const itemListElements = items.slice(0, 100).map((tool, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
        "@type": "SoftwareApplication",
        name: tool.title,
        url: tool.slug ? `https://riseofmachine.com${urlBase}/${tool.slug}` : tool.url,
        description: tool.body,
        applicationCategory: "MultimediaApplication",
    },
}));

const schema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: listName,
    numberOfItems: items.length,
    itemListElement: itemListElements,
};
---

<script type="application/ld+json" set:html={serializeJsonLd(schema)} />
